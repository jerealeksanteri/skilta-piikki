# Local development settings, read by docker compose (copy to .env).
# DATABASE_URL and DEV_MODE are set in docker-compose.yml.

# Optional in dev: with DEV_MODE the bot only logs messages instead of sending them.
BOT_TOKEN=
# Telegram IDs that are made admins on startup (comma-separated).
ADMIN_TELEGRAM_IDS=
AUTO_APPROVE_PURCHASES=true
CORS_ORIGINS=*
